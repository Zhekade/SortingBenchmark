<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Копіюватимемо DLL з C++ проекту після його збірки (в налаштуваннях SLN C++ має збиратися першим) -->
    <!-- Щоб C# знайшов DLL, C++ проект налаштовано на вивід DLL у папку C# -->
  </ItemGroup>

  <Target Name="CompileCppLibrary" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="[MSBuild] Запуск build_cpp.ps1 для збірки нативної DLL..." />
    
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build_cpp.ps1&quot;" 
          WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
          
    <Exec Command="pwsh -File &quot;$(MSBuildProjectDirectory)\..\build_cpp.ps1&quot;" 
          WorkingDirectory="$(MSBuildProjectDirectory)\.."
          Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

</Project>
