<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SortingRunner\SortingRunner.csproj" />
  </ItemGroup>

  <Target Name="CopySortingCoreDll" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\SortingRunner\bin\$(Configuration)\net10.0\SortingCore.dll" 
          DestinationFolder="$(OutDir)" 
          SkipUnchangedFiles="true" 
          Condition="Exists('$(MSBuildProjectDirectory)\..\SortingRunner\bin\$(Configuration)\net10.0\SortingCore.dll')" />
  </Target>

</Project>
